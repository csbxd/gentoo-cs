FROM docker.io/library/ubuntu:18.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang cmake ninja-build python python-dev python-setuptools \
    python-pip python-requests git curl wget ca-certificates xz-utils unzip zip \
    pkg-config bison flex gperf nodejs libasound2-dev libcap-dev libcups2-dev \
    libdbus-1-dev libgconf2-dev libgnome-keyring-dev libgtk2.0-dev libgtk-3-dev \
    libnotify-dev libnss3-dev libx11-xcb-dev libxss-dev libxtst-dev libpulse-dev \
    libpci-dev libdrm-dev libgbm-dev libkrb5-dev libudev-dev libssl-dev \
    libxkbcommon-dev libxrandr-dev libxi-dev libxcursor-dev libxcomposite-dev \
    libxdamage-dev libxfixes-dev libxrender-dev libexpat1-dev libfontconfig1-dev \
    libfreetype6-dev libglib2.0-dev libharfbuzz-dev libjpeg-dev zlib1g-dev \
    libpng-dev libevent-dev libsnappy-dev libxml2-dev libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
