+import unittest
+from serve.server import Service
+
+class ProjectionAliasTests(unittest.TestCase):
+    def service(self, enabled=True):
+        s=Service.__new__(Service)
+        s.model='test-model';s.aliases=['test-model-sp'] if enabled else []
+        s.model_arch=None;s.sampling_defaults={'experimental_speed_projection':False,'temperature':0.8}
+        s.shared={}
+        return s
+    def test_registered_names_have_distinct_defaults(self):
+        s=self.service()
+        self.assertFalse(s.request_sampling({'model':s.model},False)['experimental_speed_projection'])
+        self.assertTrue(s.request_sampling({'model':s.model+'-sp'},False)['experimental_speed_projection'])
+        self.assertEqual(s.model_for({'model':s.model+'-sp'}),s.model+'-sp')
+    def test_existing_aliases_do_not_opt_in(self):
+        s=self.service(False);s.aliases=['ordinary'];s.sampling_defaults['experimental_speed_projection']=True
+        self.assertIsNone(s.model_projection_default({'model':s.model}))
+        self.assertTrue(s.request_sampling({'model':'ordinary'},False)['experimental_speed_projection'])
+    def test_explicit_request_still_wins(self):
+        s=self.service()
+        self.assertFalse(s.request_sampling({'model':s.model+'-sp','experimental_speed_projection':False},False)['experimental_speed_projection'])
+        self.assertTrue(s.request_sampling({'model':s.model,'experimental_speed_projection':True},False)['experimental_speed_projection'])
+    def test_model_preset_overrides_global_defaults(self):
+        s=self.service();s.shared={'experimental_speed_projection':False}
+        self.assertTrue(s.request_sampling({'model':s.model+'-sp'},False)['experimental_speed_projection'])
+        s.shared['experimental_speed_projection']=True
+        self.assertFalse(s.request_sampling({'model':s.model},False)['experimental_speed_projection'])
+    def test_requests_do_not_mutate_global_state(self):
+        s=self.service();before=(dict(s.shared),dict(s.sampling_defaults))
+        for name in (s.model+'-sp',s.model,s.model+'-sp'):
+            request={'model':name,'temperature':0}
+            self.assertEqual(s.request_sampling(request,False)['temperature'],0)
+            self.assertEqual(request,{'model':name,'temperature':0})
+        self.assertEqual((s.shared,s.sampling_defaults),before)
+    def test_non_projection_parameters_keep_existing_precedence(self):
+        s=self.service();s.shared={'temperature':0.6,'top_p':0.9}
+        r=s.request_sampling({'model':s.model+'-sp','temperature':0,'top_p':None},False)
+        self.assertEqual(r['temperature'],0);self.assertEqual(r['top_p'],0.9)
+    def test_no_defaults_preserves_none(self):
+        s=self.service(False);s.shared={};s.sampling_defaults={}
+        self.assertIsNone(s.request_sampling(None,False))
+
+if __name__=='__main__':unittest.main()
