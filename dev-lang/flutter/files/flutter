#!/bin/sh

# Git only trusts repositories owned by the current UID. The Flutter SDK is a
# shared root:flutter checkout, so mark only that tree as safe for this command
# and its Git subprocesses without modifying global user configuration.
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=safe.directory
export GIT_CONFIG_VALUE_0=/opt/flutter

# Android Gradle Plugin publishes only an x86-64 Linux aapt2. On a Linux
# ARM64 host, transparently redirect Flutter's Gradle subprocess to the native
# SDK binary. This affects only this Flutter invocation and does not modify
# global or project Gradle configuration.
if [ "$(uname -s)" = Linux ]; then
	case "$(uname -m)" in
		aarch64|arm64)
			android_sdk_root=${ANDROID_SDK_ROOT:-${ANDROID_HOME:-${HOME}/Android/Sdk}}
			aapt2_path="${android_sdk_root}/build-tools/36.1.0/aapt2"
			if [ -x "${aapt2_path}" ]; then
				aapt2_override="-Dorg.gradle.project.android.aapt2FromMavenOverride=${aapt2_path}"
				case " ${GRADLE_OPTS-} " in
					*org.gradle.project.android.aapt2FromMavenOverride=*) ;;
					*)
						GRADLE_OPTS="${GRADLE_OPTS:+${GRADLE_OPTS} }${aapt2_override}"
						export GRADLE_OPTS
						;;
				esac
			fi
			;;
	esac
fi

/opt/flutter/bin/flutter "$@"
flutter_status=$?

# Flutter 3.47.1's linux-arm64 engine archive contains an unused x86-64 copy.
# The active frontend server comes from the ARM64 system Dart SDK.
rm -f /opt/flutter/bin/cache/artifacts/engine/linux-arm64/frontend_server_aot.dart.snapshot 2>/dev/null || :

exit "${flutter_status}"
