# Merge into a complete savedconfig; this is not a standalone kernel config.
# Requires USE="debug savedconfig" with ophub-kernel.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_FUNCTION_TRACER=y
# bpftune resolves data symbols such as init_net and softnet_data at load time.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
